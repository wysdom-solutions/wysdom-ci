# Normalize line endings to LF. The workflows embed bash that runs on Linux runners,
# so LF must be preserved regardless of the committer's OS.
* text=auto eol=lf

# Be explicit for the CI-critical file types.
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
